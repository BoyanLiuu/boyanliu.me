# Copy to .env.local and fill in. Never commit real values.
# Public base URL of the site (used for absolute URLs in feeds, sitemap and OG tags).
NEXT_PUBLIC_SITE_URL=https://boyanliu.me

# Contact form. Without both of these the form refuses to send and tells the visitor to
# email directly, so it never reports a message as delivered when it was not.
# Resend API key (https://resend.com/api-keys). Server-side only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# The verified sender the mail comes from, e.g. "Contact form <contact@boyanliu.me>".
# The domain must be verified in Resend. Messages are delivered to author.email in content/site.json.
CONTACT_FROM_EMAIL=
